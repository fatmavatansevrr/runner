{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkoutDefinitionCapabilityOverlay",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "documentType": { "const": "WORKOUT_DEFINITION_CAPABILITY_OVERLAY" },
        "schemaVersion": { "const": 1 },
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "RETIRED"] },
        "contentHash": { "type": "string" }
      },
      "required": ["documentType", "schemaVersion", "key", "version", "status"],
      "additionalProperties": false
    },
    "workoutDefinitionRef": {
      "type": "object",
      "properties": {
        "documentType": { "const": "WORKOUT_DEFINITION" },
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      },
      "required": ["documentType", "key", "version"],
      "additionalProperties": false
    },
    "allowedDistanceAccountingModes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["EXACT_SESSION_TOTAL", "ESTIMATED_SESSION_TOTAL", "EMBEDDED_COMPONENTS"] }
    }
  },
  "required": ["metadata", "workoutDefinitionRef", "allowedDistanceAccountingModes"],
  "additionalProperties": false
}
