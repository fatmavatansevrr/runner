{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreparationRunwayBlockProgressionDefinition",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "documentType": { "const": "PREPARATION_RUNWAY_BLOCK_PROGRESSION" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "RETIRED"] }
      },
      "required": ["documentType", "schemaVersion", "key", "version", "status"]
    },
    "distanceFamily": { "type": "string", "enum": ["FIVE_K", "TEN_K", "HALF_MARATHON", "MARATHON"] },
    "blockType": { "type": "string", "enum": ["CONSISTENCY", "GENERAL_ENDURANCE", "AEROBIC_STRENGTH", "PRE_SPECIFIC_TRANSITION"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "stepOrder": { "type": "integer", "minimum": 1 },
          "stepKey": { "type": "string", "minLength": 1 },
          "workoutCandidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "documentType": { "const": "WORKOUT_DEFINITION" },
                "key": { "type": "string" },
                "version": { "type": "integer" }
              },
              "required": ["documentType", "key", "version"]
            }
          }
        },
        "required": ["stepOrder", "stepKey", "workoutCandidates"],
        "additionalProperties": false
      }
    }
  },
  "required": ["metadata", "distanceFamily", "blockType", "steps"]
}
