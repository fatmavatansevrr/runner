{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LongHorizonGeStageFamilyCatalog",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "documentType": { "const": "LONG_HORIZON_GE_STAGE_FAMILY_CATALOG" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "key": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "RETIRED"] }
      },
      "required": ["documentType", "schemaVersion", "key", "version", "status"]
    },
    "distanceFamily": { "type": "string", "enum": ["FIVE_K", "TEN_K", "HALF_MARATHON", "MARATHON"] },
    "stageFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "stageFamilyKey": {
            "type": "string",
            "enum": ["ENTRY", "BASE_DEVELOPMENT", "AEROBIC_DURABILITY", "CONSOLIDATION", "PRE_RUNWAY_ALIGNMENT"]
          },
          "eligibleContexts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["SHORT_EXTENSION", "MESOCYCLE", "TERMINAL_REMAINDER"] }
          },
          "recoveryCompatible": { "type": "boolean" },
          "maxConsecutiveMesocycles": { "type": "integer", "minimum": 0 },
          "roleAssignments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "enum": ["KEY_SESSION", "EASY_SUPPORT", "LONG_RUN"] },
                "profile": { "type": "string", "enum": ["CONSISTENCY_NEEDED", "CORE_ENTRY_READY", "ANY"] },
                "workoutCandidates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "documentType": { "const": "WORKOUT_DEFINITION" },
                      "key": { "type": "string" },
                      "version": { "type": "integer" }
                    },
                    "required": ["documentType", "key", "version"]
                  }
                }
              },
              "required": ["role", "profile", "workoutCandidates"],
              "additionalProperties": false
            }
          }
        },
        "required": ["stageFamilyKey", "eligibleContexts", "recoveryCompatible", "maxConsecutiveMesocycles", "roleAssignments"],
        "additionalProperties": false
      }
    }
  },
  "required": ["metadata", "distanceFamily", "stageFamilies"]
}
