<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RunningApp.Domain\RunningApp.Domain.csproj" />
    <ProjectReference Include="..\RunningApp.Persistence\RunningApp.Persistence.csproj" />
    <!-- Phase 10K-FREQ.6D.3D: the immutable Process A->B execution-value boundary only.
         RunningApp.Application MUST NOT reference PlanCatalog.Core or PlanCatalog.Infrastructure
         (authoring/projection authorities) - see RunningAppPlanCatalogDependencyTests. -->
    <ProjectReference Include="..\..\plan-catalog\src\PlanCatalog.Contracts\PlanCatalog.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Backend Integration Phase 4E.1: lets RunningApp.IntegrationTests directly
         unit-test CatalogPreviewGenerator's internal NotEvaluated governance-policy
         mapping (ApplyNotEvaluatedGovernancePolicy) without reflection. No production
         behavior change; visibility only. -->
    <InternalsVisibleTo Include="RunningApp.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
    <!-- Phase 4F.9.3: IHostEnvironment, used by LivePlanPreviewRoutingService to gate
         the Development-only local-acceptance override independently of configuration. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
